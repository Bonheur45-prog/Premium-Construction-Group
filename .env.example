# Leave DATABASE_URL blank for the local JSON/SQLite preview stores.
# Set this to your PostgreSQL connection URL for shared/production CMS data.
DATABASE_URL=

RESEND_API_KEY=re_your_key
RESERVATION_FROM_EMAIL=Website <bookings@example.com>
RESERVATION_ADMIN_EMAIL=team@example.com
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=replace_with_a_unique_password_at_least_12_characters
RESERVATION_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Optional features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
