# Copy to .env.local for local work. On the VPS these live in /var/www/premium-construction/.env

# --- Database -------------------------------------------------------------
# Leave blank for the local JSON/SQLite preview stores. Production uses PostgreSQL.
DATABASE_URL=

# --- Public address -------------------------------------------------------
# Used for links in emails (e.g. https://pcg.zamukapos.io). Falls back to the address the visitor used.
SITE_URL=

# --- CMS access -----------------------------------------------------------
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=replace_with_a_unique_password_at_least_12_characters
RESERVATION_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# --- Email (Brevo) --------------------------------------------------------
# Brevo → SMTP & API → API keys. MAIL_FROM_EMAIL must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Premium Construction Group
# Company inbox that receives new bookings, enquiries and client messages.
STAFF_NOTIFY_EMAIL=

# --- Media (Cloudflare R2) ------------------------------------------------
# R2 → Manage API tokens (Object Read & Write). Without these, uploads are stored on the server.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket for website images/videos, and the URL it is served from (custom domain or r2.dev).
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=
# Private bucket for client documents (never made public).
R2_PRIVATE_BUCKET=

# --- Spam protection (Cloudflare Turnstile) -------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
