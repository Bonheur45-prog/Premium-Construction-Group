# Email notifications are sent through Resend. Use a sender address verified in Resend.
RESEND_API_KEY=
RESERVATION_FROM_EMAIL=Premium Construction Group <reservations@your-verified-domain.example>
RESERVATION_ADMIN_EMAIL=

# Use a unique password of at least 12 characters and a random session secret. Keep this file private as .env.local.
ADMIN_DASHBOARD_PASSWORD=
RESERVATION_SESSION_SECRET=

# Optional. The default local database is ./data/reservations.sqlite.
# On hosting, point this at persistent storage or connect a shared database before launch.
# RESERVATIONS_DB_PATH=
