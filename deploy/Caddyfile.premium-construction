# Add this block to /etc/caddy/Caddyfile on the VPS (below the existing site blocks).
# Caddy gets and renews the HTTPS certificate on its own.
# TODO: demo address on zamukapos.io — replace with the client's own domain when they sign off.
pcg.zamukapos.io {
	encode zstd gzip

	# Videos can be up to 200 MB.
	request_body {
		max_size 210MB
	}

	# Media uploaded in the CMS: Next.js only serves files that existed at build time,
	# so Caddy serves these straight from the shared folder (also faster, and no Node memory used).
	handle /uploads/* {
		root * /var/www/premium-construction/shared
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3040
	}
}
